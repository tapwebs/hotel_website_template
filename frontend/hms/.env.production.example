# TapMenu HMS Staff console: build-time variables for `npm run build` in frontend/hms.
# VITE_* values are bundled into public JavaScript: never put secrets here.

# API Base URL: set to your backend API URL, e.g. https://api.example.com
VITE_API_BASE_URL=https://api.example.com
# Website API URL for staff calls (optional, can route through HMS gateway)
VITE_SITE_API_BASE_URL=
VITE_SITE_URL=https://example.com
