# Variables read by docker-compose.prod.yml (set them in the Coolify stack, never commit real values).

POSTGRES_USER=tapmenu_admin
POSTGRES_PASSWORD=<32+ random characters>
POSTGRES_DB=tapmenu_hospitality

# JWT signing key for HMS staff tokens: openssl rand -hex 32
HMS_SECRET_KEY=<64 hex characters>
# Shared HMS <-> website key: openssl rand -hex 32
SHARED_INTEGRATION_KEY=<64 hex characters>

ALLOWED_ORIGIN=https://example.com
SITE_URL=https://example.com
GOOGLE_CLIENT_ID=

# Payments (hms-api). Guest QR online payment turns on when all three Razorpay values are set.
# PAYMENT_PROVIDER only selects the front-desk ledger gateway: demo | razorpay | bank
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
