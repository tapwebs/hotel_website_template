# TapMenu website API (Fastify): PRODUCTION template. Set these in your production environment.

PORT=3001
TRUST_PROXY=1
# The one allowed browser origin, no trailing slash and no wildcard
ALLOWED_ORIGIN=https://example.com
SITE_URL=https://example.com

# Same database as the HMS, isolated in its own schema
DATABASE_URL=postgres://<user>:<password>@postgres:5432/<database>?schema=website
POSTGRES_POOL_SIZE=20

# HMS integration. HMS_API_KEY must equal HMS_INTEGRATION_API_KEY on the HMS API.
HMS_BASE_URL=http://hms-api:8001
HMS_API_KEY=<same value as HMS_INTEGRATION_API_KEY>

# Google sign-in (public client id) and optional analytics (service account, server-side only)
GOOGLE_CLIENT_ID=
# GA4_PROPERTY_ID=
# GA4_CLIENT_EMAIL=
# GA4_PRIVATE_KEY=
# GSC_SITE_URL=https://example.com/
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=
