# ==============================================================================
# TapMenu HMS Frontend Environment Configuration Example
# ==============================================================================
#
# Production API Base URL Configuration:
# - Leave empty (VITE_API_BASE_URL=) in local development to use Vite dev proxy (/api -> http://127.0.0.1:8000).
# - In production deployment, set this to your backend API URL (e.g. https://api.yourdomain.com).
#
# IMPORTANT SECURITY NOTICE:
# - NEVER place database connection strings, passwords, or JWT secrets in VITE_* variables.
# - VITE_* variables are bundled into client-side JavaScript and visible to the public browser.
#
VITE_API_BASE_URL=

# Website backend (Fastify) base for staff calls; default goes through the vite /site-api proxy
VITE_SITE_API_BASE_URL=/site-api
# Public website origin (QR Hub admin link in the sidebar)
VITE_SITE_URL=http://localhost:5173
