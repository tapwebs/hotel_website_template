# TapMenu HMS API (FastAPI): local development template.
# Copy to backend/.env. Production values live in the host environment: see .env.production.example.

APP_ENV=development
DEBUG=True
PROJECT_NAME="TapMenu HMS Backend"
API_V1_PREFIX=/api/v1

# Demo data (fake rooms, guests and the demo staff logins). Development only: it never runs when APP_ENV=production.
ENABLE_DEMO_SEED=True

# Database
# PostgreSQL (production / Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tapmenu_hms
# Local async SQLite fallback:
# DATABASE_URL=sqlite+aiosqlite:///./tapmenu_hms.db

# Security & JWT (generate with: openssl rand -hex 32)
SECRET_KEY=dev_secret_key_change_in_production_min32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS allowed origins (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# Behind a reverse proxy (Coolify/Traefik) set TRUST_PROXY=true so real client IPs reach the rate limiter
# TRUST_PROXY=false

# Default property. The production setup scripts (backend/app/seed/production_setup.py) use these ids.
DEFAULT_PROPERTY_CODE=TM-JPR
DEFAULT_PROPERTY_ID=prop-jaipur-01
DEFAULT_ORG_ID=org-openhms-01

# Website (Fastify) integration: shared server-to-server key, never exposed to browsers.
# Must equal HMS_API_KEY on the website API. Generate with: openssl rand -hex 32
HMS_INTEGRATION_API_KEY=
# Website room id -> HMS room type code. Codes must exist (production_setup creates them).
WEBSITE_ROOM_MAP=deluxe:DLX_PALACE,super-deluxe:ROYAL_SUITE
WEBSITE_API_URL=http://127.0.0.1:3001

# Cloudflare Turnstile (optional bot protection on public forms)
# TURNSTILE_SECRET_KEY=

# Online payments (guest table orders, folio payments). "demo" simulates payments: use "razorpay" in production.
PAYMENT_PROVIDER=demo
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx   # webhook URL: https://<api-host>/api/v1/guest/payments/razorpay/webhook

# Receipts to guests (optional)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_RECEIPT_TEMPLATE=
# MSG91_AUTH_KEY=
# MSG91_RECEIPT_TEMPLATE_ID=
