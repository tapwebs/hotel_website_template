# Base URL of the auth/session/admin API. Leave unset to disable accounts. Local dev: http://localhost:3001
# VITE_AUTH_API_URL=http://localhost:3001

# Canonical site origin used at build time for canonicals, sitemap and JSON-LD.
# Defaults to http://localhost:5173 when unset.
# VITE_SITE_URL=https://example.com

# Google Identity Services Client ID for public customer sign-in (public client ID only; no secret in frontend).
# VITE_GOOGLE_CLIENT_ID=
