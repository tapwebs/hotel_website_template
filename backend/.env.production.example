# TapMenu HMS API: PRODUCTION template. Set these in your production host environment (never commit real values).

APP_ENV=production
DEBUG=false
ENABLE_DEMO_SEED=false

DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/<database>
# Pool is per uvicorn worker: WEB_CONCURRENCY x (POOL_SIZE + MAX_OVERFLOW) must stay under Postgres max_connections
WEB_CONCURRENCY=2
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
# true only if DATABASE_URL goes through pgbouncer (disables asyncpg prepared statement cache)
DB_PGBOUNCER=false

SECRET_KEY=<openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["https://example.com","https://hms.example.com"]
TRUST_PROXY=true

# Shared with the website API (its HMS_API_KEY). openssl rand -hex 32
HMS_INTEGRATION_API_KEY=<openssl rand -hex 32>
WEBSITE_API_URL=http://website-api:3001
WEBSITE_ROOM_MAP=deluxe:DLX_PALACE,super-deluxe:ROYAL_SUITE
# Public API origin: menu photo links are built on it because the HMS frontend is served from another host
PUBLIC_API_BASE_URL=https://api.example.com

# Payments: switch from the simulator once the Razorpay account is live
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# First-time setup (run once in the backend terminal, then delete the users file):
#   python -m backend.app.seed.production_bootstrap --users /tmp/users.json            # dry run
#   python -m backend.app.seed.production_bootstrap --users /tmp/users.json --apply \
#       --rooms DLX_PALACE=<room numbers> --rooms ROYAL_SUITE=<room numbers>
# Later room changes (safe to repeat): python -m backend.app.seed.production_setup --rooms CODE=101-110
