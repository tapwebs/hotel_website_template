# Port the API listens on.
PORT=3001
# The one frontend origin allowed by CORS (scheme+host[+port], no trailing slash). Required, no wildcard.
ALLOWED_ORIGIN=http://localhost:5173
# Postgres connection string (required). Append ?schema=website to isolate website tables from HMS:
DATABASE_URL=postgres://tapmenu:tapmenu_dev@localhost:5432/tapmenu_hospitality?schema=website
# Tests only. MUST be a different database whose name ends in _test (tests refuse to run otherwise; they truncate tables).
TEST_DATABASE_URL=postgres://tapmenu:tapmenu_dev@localhost:5432/tapmenu_hospitality_test?schema=website
# MANDATORY (set to 1) when running behind a reverse proxy / load balancer, otherwise the rate limit sees
# the proxy's IP and auth requests carrying X-Forwarded-For are rejected. Leave unset when exposed directly.
# TRUST_PROXY=1
# Users and sessions live in Postgres; only the rate-limit counters are per-process (see ponytail note in src/app.ts).
# HMS integration (TapMenu HMS). When both are set: website bookings sync to the HMS, HMS staff bearer tokens
# work on /admin/bookings, and website room-rate edits are refused (HMS owns rates).
# HMS_API_KEY must equal HMS_INTEGRATION_API_KEY on the HMS. Server-side only.
# HMS_BASE_URL=http://127.0.0.1:8001
# HMS_API_KEY=
# POS integration (unused)
# POS_BASE_URL=
# POS_API_KEY=
# QR Hub: public site origin that /r/:slug redirects to (defaults to ALLOWED_ORIGIN). No trailing slash.
# SITE_URL=http://localhost:5173
# QR Hub analytics (all optional; the admin UI shows "not connected" until all three of a pair are set).
# Google service account with read access to the GA4 property / Search Console site. Keys stay server-side.
# Newlines in the private key may be written as \n.
# GA4_PROPERTY_ID=
# GA4_CLIENT_EMAIL=
# GA4_PRIVATE_KEY=
# GSC_SITE_URL=https://example.com/
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=
